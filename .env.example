# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Paris

# PostgreSQL (laisser DB_HOST vide pour utiliser SQLite en local)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Durée (secondes) de réutilisation d'une connexion PostgreSQL par worker.
DB_CONN_MAX_AGE=60

# Estimation des itinéraires des sorties — Géoplateforme IGN, sans clé API
ROUTING_PROVIDER=geoplateforme
ROUTING_API_URL=https://data.geopf.fr/navigation/itineraire
ROUTING_GEOCODING_URL=https://data.geopf.fr/geocodage/search
ROUTING_RESOURCE=bdtopo-osrm
ROUTING_TIMEOUT_SECONDS=8

# Stockage Supabase S3 (laisser vide pour stocker dans media/)
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=Documents
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_CUSTOM_DOMAIN=
SUPABASE_S3_LOCATION=

# SMTP (sans EMAIL_HOST, les e-mails sont affichés dans la console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Gestion animation <noreply@example.test>
EMAIL_REPLY_TO=

# Optionnel : future intégration de la Vigilance officielle Météo-France.
METEOFRANCE_VIGILANCE_API_KEY=
